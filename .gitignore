# Virtual Environment
venv/
env/

# Python
__pycache__/
*.py[cod]
*$py.class
*.so
.Python

# Jupyter Notebooks
.ipynb_checkpoints/
*.ipynb_checkpoints

# Data (too large for git)
data/raw/*
data/processed/*
data/augmented/*
!data/raw/.gitkeep
!data/processed/.gitkeep
!data/augmented/.gitkeep

# Models (too large for git)
models/*
!models/.gitkeep

# Logs
logs/*.log
*.log

# OS
.DS_Store
Thumbs.db

# IDE
.vscode/
.idea/
*.swp
*.swo

# Results (can be regenerated)
results/figures/*
results/metrics/*
!results/figures/.gitkeep
!results/metrics/.gitkeep

# DVC
/dvc.lock

# MLflow
mlruns/
mlartifacts/
.mlflow/

# Temporary files
*.tmp
*.bak
/logs

ESP32_S3_verification/
